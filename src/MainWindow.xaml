<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DesktopTodo;assembly=DeskTodo"
        Title="DeskTodo" Width="360" Height="520" MinWidth="320" MinHeight="360"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="True" FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI" FontSize="12.5" TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <!-- Replace WPF's dotted keyboard-focus adorner for every control in this window. -->
    <Style x:Key="{x:Static SystemParameters.FocusVisualStyleKey}">
      <Setter Property="Control.Template"><Setter.Value><ControlTemplate><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <SolidColorBrush x:Key="CardBrush" Color="#FCFCFA"/>
    <SolidColorBrush x:Key="TextBrush" Color="#263D35"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#88938D"/>
    <SolidColorBrush x:Key="LineBrush" Color="#E7EBE5"/>
    <SolidColorBrush x:Key="InputBrush" Color="#F0F3ED"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#3B795C"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#E9F0E6"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CheckLineBrush" Color="#8F8F89"/>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
    <Style TargetType="Path"><Setter Property="StrokeThickness" Value="1.3"/><Setter Property="StrokeStartLineCap" Value="Round"/><Setter Property="StrokeEndLineCap" Value="Round"/><Setter Property="StrokeLineJoin" Value="Round"/><Setter Property="SnapsToDevicePixels" Value="False"/></Style>
    <Style x:Key="IconButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/><Setter Property="Padding" Value="4"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Grid><Border x:Name="HoverSurface" Background="{DynamicResource HoverBrush}" CornerRadius="7" Opacity="0"/>
          <Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><local:InkContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="HoverSurface" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
            <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="HoverSurface" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
          </Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.7"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="GroupPickerButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Surface" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/></Grid.ColumnDefinitions>
            <local:InkContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Path Grid.Column="1" Data="M 1,2 L 4,5 L 7,2" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1" Width="8" Height="7" Stretch="None" VerticalAlignment="Center"/>
          </Grid>
        </Border>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ResizeEdgeThumb" TargetType="Thumb">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="LockIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
          <local:InkContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="AddButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/>
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8"><local:InkContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.86"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.7"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="TaskCheck" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Width" Value="28"/><Setter Property="Height" Value="38"/>
      <Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="VerticalAlignment" Value="Top"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="UseLayoutRounding" Value="False"/><Setter Property="SnapsToDevicePixels" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Grid Background="Transparent"><Border x:Name="Box" Width="16" Height="16" CornerRadius="4.5" BorderThickness="1.1" BorderBrush="{DynamicResource CheckLineBrush}" Background="Transparent" VerticalAlignment="Top" Margin="0,11,0,0" HorizontalAlignment="Left">
          <Path x:Name="Tick" Data="M 2.5,7 L 5.7,10.1 L 11.2,4.2" Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="1.3" Visibility="Collapsed"/>
        </Border></Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource TextBrush}"/><Setter TargetName="Box" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
          <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsChecked" Value="True"/></MultiTrigger.Conditions><Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}"/></MultiTrigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="CompletedExpander" TargetType="Expander">
      <Setter Property="UseLayoutRounding" Value="False"/><Setter Property="SnapsToDevicePixels" Value="False"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Focusable" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
        <StackPanel>
          <ToggleButton x:Name="HeaderToggle" AutomationProperties.Name="展开或收起已完成" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" HorizontalContentAlignment="Left" Cursor="Hand" FocusVisualStyle="{x:Null}">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
              <Border Background="Transparent" Padding="0,16">
                <StackPanel Orientation="Horizontal">
                  <Path x:Name="Arrow" Data="M 5.5,3 L 10.5,8 L 5.5,13" Width="16" Height="16" Margin="0,0,6,0" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="None" VerticalAlignment="Center" SnapsToDevicePixels="False"/>
                  <local:InkContentPresenter VerticalAlignment="Center"/>
                </StackPanel>
              </Border>
              <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="Data" Value="M 3,5.5 L 8,10.5 L 13,5.5"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></ToggleButton.Template>
            <local:InkContentPresenter Content="{TemplateBinding Header}"/>
          </ToggleButton>
          <local:InkContentPresenter x:Name="ExpandedContent" Visibility="Collapsed"/>
        </StackPanel>
        <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="ExpandedContent" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="5"/><Setter Property="MinWidth" Value="0"/>
      <Setter Property="Opacity" Value="0.55"/>
      <Setter Property="Focusable" Value="False"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
        <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
          <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb MinHeight="24" Focusable="False" FocusVisualStyle="{x:Null}"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource MutedBrush}" CornerRadius="2.5"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
          <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
        </Track>
      </ControlTemplate></Setter.Value></Setter>
      <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="1"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="SettingToggle" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,0,2"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="UseLayoutRounding" Value="False"/><Setter Property="SnapsToDevicePixels" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Border x:Name="Row" Background="Transparent" CornerRadius="8" Padding="10,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <local:InkContentPresenter VerticalAlignment="Center"/>
          <Grid x:Name="Track" Grid.Column="1" Width="32" Height="18" Margin="12,0,0,0" VerticalAlignment="Center">
            <Border Background="{DynamicResource LineBrush}" CornerRadius="9"/>
            <Border x:Name="ActiveTrack" Background="{DynamicResource AccentBrush}" CornerRadius="9" Opacity="0"/>
            <Ellipse x:Name="Knob" Width="14" Height="14" Fill="{DynamicResource CardBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2"><Ellipse.RenderTransform><TranslateTransform X="0"/></Ellipse.RenderTransform></Ellipse>
          </Grid>
        </Grid></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Knob" Property="Fill" Value="{DynamicResource AccentTextBrush}"/>
            <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="14" Duration="0:0:0.16"/><DoubleAnimation Storyboard.TargetName="ActiveTrack" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
            <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.16"/><DoubleAnimation Storyboard.TargetName="ActiveTrack" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
          </Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
      <Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="34"/><Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="{DynamicResource InputBrush}"/>
      <Setter Property="Padding" Value="12,6"/><Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Grid>
          <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0.8" CornerRadius="8"/>
          <Border x:Name="HoverSurface" Background="{DynamicResource HoverBrush}" CornerRadius="7.5" Margin="0.8" Opacity="0" IsHitTestVisible="False"/>
          <Border Padding="{TemplateBinding Padding}"><local:InkContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="HoverSurface" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
            <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="HoverSurface" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
          </Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.8"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SettingsCategoryButton" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource InputBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="BorderThickness" Value="0.8"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Grid>
          <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0.8" CornerRadius="10"/>
          <Border x:Name="HoverSurface" Background="{DynamicResource HoverBrush}" CornerRadius="9.5" Margin="0.8" Opacity="0" IsHitTestVisible="False"/>
          <Border Padding="{TemplateBinding Padding}" Background="Transparent"><local:InkContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/></Border>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="HoverSurface" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
            <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="HoverSurface" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
          </Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.88"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SettingInput" TargetType="TextBox">
      <Setter Property="Height" Value="36"/><Setter Property="Padding" Value="0"/><Setter Property="TextAlignment" Value="Center"/>
      <Setter Property="Background" Value="{DynamicResource CardBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
        <Grid UseLayoutRounding="False" SnapsToDevicePixels="False">
          <Border Background="{TemplateBinding Background}" CornerRadius="7"/>
          <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" Margin="9,4" ClipToBounds="True"/>
          <local:InputOutline x:Name="InputSurface" BorderBrush="{DynamicResource InputLineBrush}" BorderThickness="1.25" Margin="1" CornerRadius="7" UseLayoutRounding="False" SnapsToDevicePixels="False" IsHitTestVisible="False"/>
        </Grid>
        <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="InputSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SettingSlider" TargetType="Slider">
      <Setter Property="Height" Value="24"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
        <Grid Background="Transparent" VerticalAlignment="Center">
          <Track x:Name="PART_Track" Height="18" VerticalAlignment="Center">
            <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Grid Background="Transparent"><Border Height="4" Background="{DynamicResource AccentBrush}" CornerRadius="2" VerticalAlignment="Center"/></Grid></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
            <Track.Thumb><Thumb Width="16" Height="16" Focusable="False"><Thumb.Template><ControlTemplate TargetType="Thumb"><Grid Background="Transparent"><Ellipse Fill="{DynamicResource AccentBrush}" Stroke="{DynamicResource CardBrush}" StrokeThickness="2"/></Grid></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
            <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Grid Background="Transparent"><Border Height="4" Background="{DynamicResource LineBrush}" CornerRadius="2" VerticalAlignment="Center"/></Grid></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
          </Track>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SpinButton" TargetType="Button">
      <Setter Property="Width" Value="18"/><Setter Property="Height" Value="17"/><Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="4"><local:InkContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.65"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="PresetChoice" TargetType="RadioButton">
      <Setter Property="Height" Value="42"/><Setter Property="MinWidth" Value="58"/><Setter Property="Margin" Value="0,0,7,7"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Surface" Background="{DynamicResource InputBrush}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="9" Padding="10,6"><local:InkContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.82"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="CornerChoice" TargetType="RadioButton">
      <Setter Property="Height" Value="34"/><Setter Property="Margin" Value="0,0,3,0"/><Setter Property="FontSize" Value="11"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Surface" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Background="Transparent" CornerRadius="8" Padding="4"><local:InkContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.82"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ThemeChoice" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="FontSize" Value="11"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Margin" Value="0,0,7,7"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Border x:Name="Choice" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0.8" CornerRadius="8" Padding="10,9">
          <StackPanel Orientation="Horizontal"><Ellipse Width="10" Height="10" Fill="{TemplateBinding Tag}" Margin="0,0,7,0" VerticalAlignment="Center"/><local:InkContentPresenter VerticalAlignment="Center"/></StackPanel>
        </Border>
        <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Choice" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Choice" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Choice" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Height" Value="34"/><Setter Property="MinWidth" Value="78"/><Setter Property="Padding" Value="16,6"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
      <Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Grid>
          <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8"/>
          <Border x:Name="HoverSurface" Background="{DynamicResource AccentTextBrush}" CornerRadius="8" Opacity="0" IsHitTestVisible="False"/>
          <Border Padding="{TemplateBinding Padding}"><local:InkContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <Border x:Name="FocusSurface" BorderBrush="{DynamicResource AccentTextBrush}" BorderThickness="1" CornerRadius="6" Margin="2.5" Opacity="0.6" Visibility="Collapsed" IsHitTestVisible="False"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="HoverSurface" Storyboard.TargetProperty="Opacity" To="0.08" Duration="0:0:0.12"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
            <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="HoverSurface" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
          </Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusSurface" Property="Visibility" Value="Visible"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.8"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="TaskMenu" TargetType="ContextMenu">
      <Setter Property="HasDropShadow" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
        <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="5"><ItemsPresenter/></Border>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="TaskMenuItem" TargetType="MenuItem">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
        <Grid>
          <Border x:Name="Surface" Background="{DynamicResource HoverBrush}" CornerRadius="6" Opacity="0" IsHitTestVisible="False"/>
          <Border Background="Transparent" Padding="14,9"><local:InkContentPresenter ContentSource="Header"/></Border>
        </Grid>
        <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True">
          <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Surface" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.10"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
          <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Surface" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.10"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
        </Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="TaskSubmenuItem" TargetType="MenuItem">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem"><Grid><Border x:Name="Surface" Background="Transparent" CornerRadius="6" Padding="14,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions><local:InkContentPresenter ContentSource="Header"/><Path Grid.Column="1" Data="M 5,3 L 9,7 L 5,11" Stroke="{DynamicResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border><Popup x:Name="PART_Popup" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Right" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="9" Padding="5" Margin="3,0,0,0"><StackPanel IsItemsHost="True" MinWidth="130"/></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ModernComboBoxItem" TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Padding" Value="11,8"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Choice" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}"><local:InkContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Choice" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Choice" Property="Background" Value="{DynamicResource HoverBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ModernComboBox" TargetType="ComboBox">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="{DynamicResource InputBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="11,0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="ItemContainerStyle" Value="{StaticResource ModernComboBoxItem}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton x:Name="DropDownToggle" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Background="Transparent" BorderThickness="0"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="Surface" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="9"><Grid><local:InkContentPresenter Margin="11,0,34,0" VerticalAlignment="Center" HorizontalAlignment="Left" TextElement.Foreground="{DynamicResource TextBrush}" Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"/><Path Data="M 2,3 L 6,7 L 10,3" Width="12" Height="9" Stretch="None" Stroke="{DynamicResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton><Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="9" Margin="0,4,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer Margin="4" MaxHeight="230"><StackPanel IsItemsHost="True"/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid>
  <Grid x:Name="DpiSurface">
  <!-- Shadow on a separate shape keeps animated text crisp and follows card opacity. -->
  <Grid x:Name="CardShadow" IsHitTestVisible="False" Opacity="{Binding Opacity, ElementName=Card}">
    <local:SoftCardShadow Margin="8" IsHitTestVisible="False" UseLayoutRounding="False" SnapsToDevicePixels="False"/>
  </Grid>
  <Border x:Name="Card" Background="{DynamicResource CardBrush}" CornerRadius="18" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0.7" Margin="8" SnapsToDevicePixels="False">
    <Grid x:Name="CardContent">
    <Grid x:Name="MainPanel" Margin="22,20,22,16">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid x:Name="DragHeader" Background="Transparent" Margin="0,0,0,20" Cursor="SizeAll">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Image x:Name="HeaderIcon" Width="28" Height="28" Margin="0,0,10,0" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
            <Grid Width="126" Height="34" VerticalAlignment="Center">
              <TextBlock x:Name="TitleLabel" Text="DeskTodo" FontSize="21" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="可在设置中修改名称"/>
              <Border x:Name="TitleEditSurface" Visibility="Collapsed" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="7" Padding="7,1">
                <TextBox x:Name="TitleEditor" MaxLength="12" FontSize="20" FontWeight="SemiBold" Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0" Padding="0" VerticalContentAlignment="Center" FocusVisualStyle="{x:Null}" AutomationProperties.Name="主页标题"/>
              </Border>
            </Grid>
          </StackPanel>
          <TextBlock x:Name="DateLabel" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,10,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,-2,-5,0">
          <Button x:Name="LockButton" Style="{StaticResource LockIconButton}" ToolTip="锁定位置" AutomationProperties.Name="锁定位置"><Grid x:Name="LockGlyph" Width="16" Height="16" IsHitTestVisible="False" UseLayoutRounding="False" SnapsToDevicePixels="False"><Path Data="M 3,7 L 13,7 L 13,14 L 3,14 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" StrokeLineJoin="Round"/><Path x:Name="LockShackle" Data="M 5,7 L 5,4.5 C 5,0.5 11,0.5 11,4.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Grid></Button>
          <Button x:Name="CompactButton" Style="{StaticResource IconButton}" Width="24" Visibility="Collapsed" ToolTip="缩成悬浮图标" AutomationProperties.Name="缩成悬浮图标" IsTabStop="False" Focusable="False">
            <Grid Width="16" Height="16" IsHitTestVisible="False"><Path Data="M 3,5 L 11,5 L 11,13 L 3,13 Z M 8,2 L 14,2 L 14,8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Grid>
          </Button>
          <Button x:Name="MenuButton" Style="{StaticResource IconButton}" ToolTip="设置" AutomationProperties.Name="设置">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
              <Ellipse Width="2.5" Height="2.5" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="1.5,0"/>
              <Ellipse Width="2.5" Height="2.5" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="1.5,0"/>
              <Ellipse Width="2.5" Height="2.5" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="1.5,0"/>
            </StackPanel>
          </Button>
          <Button x:Name="MinimizeButton" Style="{StaticResource IconButton}" Width="24" Visibility="Collapsed" ToolTip="最小化到托盘" AutomationProperties.Name="最小化到托盘" IsTabStop="False" Focusable="False">
            <Grid x:Name="MinimizeGlyph" Width="16" Height="16" IsHitTestVisible="False" UseLayoutRounding="False" SnapsToDevicePixels="False"><Path Data="M 2,8 L 14,8" Width="16" Height="16" Stretch="None" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
          </Button>
          <Button x:Name="CloseButton" Style="{StaticResource IconButton}" Width="24" Visibility="Collapsed" ToolTip="关闭 DeskTodo" AutomationProperties.Name="关闭 DeskTodo" IsTabStop="False" Focusable="False">
            <Grid x:Name="CloseGlyph" Width="16" Height="16" IsHitTestVisible="False"><Path Data="M 3,3 L 13,13 M 13,3 L 3,13" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Grid>
          </Button>
        </StackPanel>
      </Grid>
      <Border x:Name="AddBar" Grid.Row="1" Background="{DynamicResource InputBrush}" CornerRadius="11" Padding="12,5,5,5" Margin="0,0,0,22" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0.8">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Grid>
            <TextBox x:Name="AddInput" Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0" Padding="0,5" VerticalContentAlignment="Center" MaxLength="500" MaxHeight="76" FontSize="13" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FocusVisualStyle="{x:Null}" AutomationProperties.Name="添加待办"/>
            <TextBlock x:Name="InputHint" Text="添加一件要做的事…" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False" VerticalAlignment="Center">
              <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=AddInput}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=AddInput}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
          </Grid>
          <Button Grid.Column="2" x:Name="AddButton" Style="{StaticResource AddButtonStyle}" ToolTip="添加（Enter）" AutomationProperties.Name="添加">
            <Grid Width="18" Height="18" IsHitTestVisible="False">
              <Border Width="14" Height="1.8" CornerRadius="0.9" Background="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <Border Width="1.8" Height="14" CornerRadius="0.9" Background="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
          </Button>
          <Button Grid.Column="1" x:Name="AddGroupButton" Style="{StaticResource GroupPickerButton}" Width="72" Height="31" Margin="0,0,6,0" Padding="3,0" FontSize="10" VerticalAlignment="Center" ToolTip="选择新待办的分组或创建分组" AutomationProperties.Name="选择新待办分组"><TextBlock x:Name="AddGroupLabel" Text="未分组" Width="53" TextAlignment="Center" TextTrimming="CharacterEllipsis"/></Button>
        </Grid>
      </Border>
      <Grid x:Name="TaskArea" Grid.Row="2">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,10"><TextBlock x:Name="PendingSectionLabel" Text="未完成" FontSize="10.5" FontWeight="Medium" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/><StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="GroupButton" Style="{StaticResource IconButton}" Height="24" MinWidth="48" Width="Auto" Padding="7,2" Margin="0,0,6,0" FontSize="10" Content="全部" ToolTip="选择或管理分组" AutomationProperties.Name="待办分组" Visibility="Collapsed"/><Button x:Name="SortButton" Style="{StaticResource IconButton}" Height="24" MinWidth="48" Width="Auto" Padding="7,2" Margin="0,0,8,0" FontSize="10" Content="↑ 升序" ToolTip="点击切换升序和降序" AutomationProperties.Name="待办排序"/><TextBlock x:Name="PendingCount" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource MutedBrush}"/></StackPanel></Grid>
        <ScrollViewer x:Name="PendingScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
          <StackPanel>
            <StackPanel x:Name="PendingList"/>
            <StackPanel x:Name="EmptyPanel" Margin="0,32,0,30" HorizontalAlignment="Center">
              <Border Width="46" Height="46" CornerRadius="23" Background="{DynamicResource InputBrush}" HorizontalAlignment="Center"><Path Data="M 13,23 L 20,30 L 33,16" Stroke="#A6B6A6" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Border>
              <TextBlock x:Name="EmptyTitle" Text="把想做的事，先记下来" HorizontalAlignment="Center" Margin="0,15,0,6" FontSize="13"/>
              <TextBlock x:Name="EmptySubtitle" Text="一件一件来，不必着急" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" FontSize="11"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
            <Grid x:Name="CompletedDock" Grid.Row="2" Margin="0,10,6,0">
              <Expander x:Name="CompletedSection" Style="{StaticResource CompletedExpander}" IsExpanded="False" AutomationProperties.Name="已完成">
                <Expander.Header><TextBlock x:Name="CompletedHeader" Text="已完成（0）" Foreground="{DynamicResource MutedBrush}" FontSize="10.5" FontWeight="Medium"/></Expander.Header>
                <ScrollViewer x:Name="CompletedScroll" MaxHeight="180" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="CompletedList"/></ScrollViewer>
              </Expander>
              <Button x:Name="ClearCompletedButton" HorizontalAlignment="Right" VerticalAlignment="Top" Width="28" Height="32" Margin="0,10,0,0" Style="{StaticResource IconButton}" ToolTip="清空已完成" AutomationProperties.Name="清空已完成">
                <Grid Width="16" Height="16" IsHitTestVisible="False" UseLayoutRounding="False" SnapsToDevicePixels="False"><Path Data="M 2.5,4.5 L 13.5,4.5 M 6,4.5 L 6,2 L 10,2 L 10,4.5 M 4,4.5 L 4.5,14 L 11.5,14 L 12,4.5 M 6.5,7 L 6.5,11.5 M 9.5,7 L 9.5,11.5" Width="16" Height="16" Stretch="None" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Grid>
              </Button>
              <Border x:Name="CompletedDivider" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" VerticalAlignment="Top" IsHitTestVisible="False"/>
            </Grid>
      </Grid>
      <Grid Grid.Row="3" Margin="0,10,0,0" x:Name="UndoPanel" Visibility="Collapsed">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="UndoMessage" Text="已移除事项" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,8,0" VerticalAlignment="Center"/>
        <Button x:Name="UndoButton" Grid.Column="1" Content="撤销" Style="{StaticResource IconButton}" Width="46" Height="24" Foreground="{DynamicResource AccentBrush}" ToolTip="Ctrl+Z"/>
      </Grid>
      <Grid Grid.Row="4" Margin="0,16,0,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border x:Name="ProgressTrack" Background="{DynamicResource LineBrush}" Height="2" CornerRadius="1.5" Margin="0,0,0,10"><Border x:Name="ProgressFill" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left" CornerRadius="1.5" Width="0"/></Border>
        <StackPanel Grid.Row="1" Orientation="Horizontal"><Ellipse x:Name="StatusDot" Fill="#79A889" Width="5" Height="5" Margin="0,0,6,0"/><TextBlock x:Name="StatusLabel" Text="已自动保存 · 桌面模式" Foreground="{DynamicResource MutedBrush}" FontSize="10"/></StackPanel>
        <TextBlock Grid.Row="1" x:Name="ProgressLabel" HorizontalAlignment="Right" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
      </Grid>
    </Grid>
    <Grid x:Name="SettingsPanel" Visibility="Collapsed" Margin="22,20,22,16" Background="{DynamicResource CardBrush}">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock x:Name="SettingsTitle" Text="设置" FontSize="21" FontWeight="Medium"/><TextBlock x:Name="SettingsSubtitle" Text="让这张卡片更适合你" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"/></StackPanel>
        <Button x:Name="SettingsBack" Grid.Column="1" Style="{StaticResource IconButton}" Background="Transparent" Content="返回" Width="50" Margin="0" ToolTip="返回待办（Esc）" Height="30"/>
      </Grid>
      <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
        <StackPanel>
          <TextBlock x:Name="BasicSectionLabel" Text="基础功能" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="10,0,0,8"/>
          <CheckBox x:Name="DesktopToggle" Style="{StaticResource SettingToggle}" AutomationProperties.Name="嵌入桌面">
            <StackPanel><TextBlock Text="嵌入桌面"/><TextBlock Text="随桌面显示，不挡住其他软件" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/></StackPanel>
          </CheckBox>
          <CheckBox x:Name="LockToggle" Style="{StaticResource SettingToggle}" Content="锁定位置和大小" AutomationProperties.Name="锁定位置和大小"/>
          <CheckBox x:Name="StartupToggle" Style="{StaticResource SettingToggle}" Content="开机自启" AutomationProperties.Name="开机自启"/>
          <CheckBox x:Name="SecondaryStartupToggle" Style="{StaticResource SettingToggle}" AutomationProperties.Name="仅连接副屏时自启">
            <StackPanel><TextBlock Text="仅连接副屏时自启"/><TextBlock Text="自动在该副屏恢复上次位置；手动启动不受限" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel>
          </CheckBox>
          <TextBlock x:Name="SecondaryDisplayLabel" Text="目标副屏" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="10,8,0,8"/>
          <ComboBox x:Name="SecondaryDisplaySelect" Style="{StaticResource ModernComboBox}" Margin="10,0,10,2" Height="38" AutomationProperties.Name="目标副屏"/>
          <TextBlock x:Name="SecondaryStartupStatus" Text="开关默认关闭" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="10,4,10,10" TextWrapping="Wrap"/>
          <CheckBox x:Name="ShowTrayToggle" Style="{StaticResource SettingToggle}" Content="显示托盘图标" AutomationProperties.Name="显示或隐藏托盘"/>
          <TextBlock x:Name="HotkeyLabel" Text="快捷键（留空关闭）" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="10,14,0,8"/>
          <TextBlock x:Name="ShowHotkeyLabel" Text="显示主窗口" Margin="10,0,0,6"/><TextBox x:Name="ShowHotkeyInput" Style="{StaticResource SettingInput}" TextAlignment="Left" Margin="10,0,10,10" MaxLength="40" AutomationProperties.Name="显示窗口快捷键"/>
          <TextBlock x:Name="MiniHotkeyLabel" Text="悬浮图标 / 恢复" Margin="10,0,0,6"/><TextBox x:Name="MiniHotkeyInput" Style="{StaticResource SettingInput}" TextAlignment="Left" Margin="10,0,10,10" MaxLength="40" AutomationProperties.Name="悬浮恢复快捷键"/>
          <Button x:Name="SaveHotkeysButton" Style="{StaticResource ActionButton}" Content="保存快捷键" Margin="10,0,10,10"/>
          <TextBlock x:Name="HotkeyStatus" Text="默认 Ctrl+Alt+D 显示，Ctrl+Alt+M 悬浮/恢复" FontSize="10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="10,0,10,10"/>
          <TextBlock x:Name="CustomSectionLabel" Text="自定义界面" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="10,14,0,8"/>
          <CheckBox x:Name="ShowMinimizeToggle" Style="{StaticResource SettingToggle}" Content="显示最小化按钮" AutomationProperties.Name="显示最小化按钮"/>
          <CheckBox x:Name="ShowCloseToggle" Style="{StaticResource SettingToggle}" Content="显示关闭按钮" AutomationProperties.Name="显示关闭按钮"/>
          <CheckBox x:Name="ShowCompactToggle" Style="{StaticResource SettingToggle}" Content="显示悬浮图标" AutomationProperties.Name="显示悬浮图标"/>
          <CheckBox x:Name="DisableGroupsToggle" Style="{StaticResource SettingToggle}" AutomationProperties.Name="关闭分组功能">
            <StackPanel><TextBlock Text="关闭分组功能"/><TextBlock Text="隐藏分组入口与标题；已有分组不会删除" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel>
          </CheckBox>
          <CheckBox x:Name="ShowTimesToggle" Style="{StaticResource SettingToggle}" AutomationProperties.Name="显示事项时间">
            <StackPanel><TextBlock Text="显示事项时间"/><TextBlock Text="未完成显示添加时间，已完成显示完成时间" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel>
          </CheckBox>
          <CheckBox x:Name="ShowDateToggle" Style="{StaticResource SettingToggle}" AutomationProperties.Name="显示月日">
            <StackPanel><TextBlock Text="显示月日"/><TextBlock Text="在事项时间前同时显示月/日" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/></StackPanel>
          </CheckBox>
          <CheckBox x:Name="MiniAlwaysOnTopToggle" Style="{StaticResource SettingToggle}" Content="悬浮图标始终置顶" AutomationProperties.Name="悬浮图标始终置顶"/>
          <TextBlock x:Name="MiniOpacityLabel" Text="悬浮图标透明度" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="10,12,0,6"/>
          <Grid Margin="10,0,10,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions><Slider x:Name="MiniOpacitySlider" Style="{StaticResource SettingSlider}" Minimum="40" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"/><TextBlock x:Name="MiniOpacityValue" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/></Grid>
          <TextBlock x:Name="LanguageLabel" Text="界面语言" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="10,14,0,8"/>
          <ComboBox x:Name="LanguageSelect" Style="{StaticResource ModernComboBox}" Margin="10,0,10,2" Height="38" AutomationProperties.Name="界面语言"><ComboBoxItem Tag="zh-CN" Content="简体中文"/><ComboBoxItem Tag="en-US" Content="English"/></ComboBox>
          <TextBlock x:Name="SoftwareNameLabel" Text="软件名称" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="10,14,0,8"/>
          <Grid Margin="10,0,10,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="TitleSettingInput" Grid.Column="0" Style="{StaticResource SettingInput}" TextAlignment="Left" MaxLength="12" AutomationProperties.Name="软件名称"/>
            <Button x:Name="TitleSaveButton" Grid.Column="2" Content="保存名称" Style="{StaticResource PrimaryButton}" Height="36" MinWidth="76" Padding="12,6"/>
          </Grid>
          <Border Height="1" Background="{DynamicResource LineBrush}" Margin="10,14,10,18"/>
          <TextBlock x:Name="ThemeLabel" Text="主题颜色" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="10,0,0,10"/>
          <RadioButton x:Name="ThemeGraphite" GroupName="Theme" Content="石墨" Style="{StaticResource ThemeChoice}" Tag="#292927" Margin="10,0,10,8" HorizontalContentAlignment="Left" AutomationProperties.Name="石墨主题"/>
          <UniformGrid x:Name="ThemeGrid" Columns="3" Rows="2" Margin="10,0,3,2">
