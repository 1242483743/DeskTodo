                </UniformGrid>
              </StackPanel>
              <Grid Grid.Row="5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="PositionRestoreButton" Content="恢复默认" Style="{StaticResource ActionButton}" Margin="0" VerticalAlignment="Top"/><Button x:Name="PositionSaveButton" Grid.Column="2" Content="保存" Style="{StaticResource PrimaryButton}" Margin="0" VerticalAlignment="Top"/></Grid>
            </Grid>
          </ScrollViewer>
        </Grid>
      </Border>
