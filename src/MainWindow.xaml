                          <Path Data="M 0,66 C 25,48 44,55 64,40 C 86,24 108,55 132,42 C 152,31 168,42 182,36 L 182,102 L 0,102 Z" Fill="#7199A5" Opacity="0.72" Stretch="Fill" VerticalAlignment="Bottom" Height="65"/>
                          <Path Data="M 0,73 C 32,58 60,74 91,61 C 116,50 144,72 182,56 L 182,102 L 0,102 Z" Fill="#8CB3AE" Opacity="0.88" Stretch="Fill" VerticalAlignment="Bottom" Height="52"/>
