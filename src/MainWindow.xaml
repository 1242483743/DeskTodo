<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskTodo" Width="360" Height="520" MinWidth="320" MinHeight="360"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="True" FontFamily="Microsoft YaHei UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <!-- Replace WPF's dotted keyboard-focus adorner for every control in this window. -->
    <Style x:Key="{x:Static SystemParameters.FocusVisualStyleKey}">
      <Setter Property="Control.Template"><Setter.Value><ControlTemplate><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <SolidColorBrush x:Key="CardBrush" Color="#FCFCFA"/>
    <SolidColorBrush x:Key="TextBrush" Color="#263D35"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#88938D"/>
    <SolidColorBrush x:Key="LineBrush" Color="#E7EBE5"/>
    <SolidColorBrush x:Key="InputBrush" Color="#F0F3ED"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#3B795C"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#E9F0E6"/>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
    <Style TargetType="Path"><Setter Property="StrokeThickness" Value="1.8"/><Setter Property="StrokeStartLineCap" Value="Round"/><Setter Property="StrokeEndLineCap" Value="Round"/><Setter Property="StrokeLineJoin" Value="Round"/><Setter Property="SnapsToDevicePixels" Value="False"/></Style>
    <Style x:Key="IconButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/><Setter Property="Padding" Value="4"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="LockIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="AddButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/>
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="UseLayoutRounding" Value="False"/><Setter Property="SnapsToDevicePixels" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8" SnapsToDevicePixels="False">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.88"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.7"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="TaskCheck" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Width" Value="30"/><Setter Property="Height" Value="38"/>
      <Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="VerticalAlignment" Value="Top"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Grid Background="Transparent">
          <Border x:Name="Box" Width="18" Height="18" CornerRadius="5" BorderThickness="1.8" BorderBrush="#AFBCAF" Background="Transparent" VerticalAlignment="Top" Margin="0,10,0,0" HorizontalAlignment="Left">
            <Path x:Name="Tick" Data="M 3,8 L 6.4,11.3 L 12,4.6" Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
          </Border>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="CompletedExpander" TargetType="Expander">
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Focusable" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
        <StackPanel>
          <ToggleButton x:Name="HeaderToggle" AutomationProperties.Name="展开或收起已完成" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" HorizontalContentAlignment="Left" Cursor="Hand" FocusVisualStyle="{x:Null}">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
              <Border Background="Transparent" Padding="0,18,0,14">
                <StackPanel Orientation="Horizontal">
                  <Path x:Name="Arrow" Data="M 5,4 L 9,8 L 5,12" Width="14" Height="16" Margin="0,0,7,0" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="None" VerticalAlignment="Center" SnapsToDevicePixels="False"/>
                  <ContentPresenter VerticalAlignment="Center"/>
                </StackPanel>
              </Border>
              <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="Data" Value="M 3,6 L 7,10 L 11,6"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></ToggleButton.Template>
            <ContentPresenter Content="{TemplateBinding Header}"/>
          </ToggleButton>
          <ContentPresenter x:Name="ExpandedContent" Visibility="Collapsed"/>
        </StackPanel>
        <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="ExpandedContent" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="5"/><Setter Property="MinWidth" Value="0"/>
      <Setter Property="Opacity" Value="0.55"/>
      <Setter Property="Focusable" Value="False"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
        <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
          <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb MinHeight="24" Focusable="False" FocusVisualStyle="{x:Null}"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource MutedBrush}" CornerRadius="2.5"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
          <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
        </Track>
      </ControlTemplate></Setter.Value></Setter>
      <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="1"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="SettingToggle" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,0,2"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="UseLayoutRounding" Value="False"/><Setter Property="SnapsToDevicePixels" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Border x:Name="Row" Background="Transparent" CornerRadius="10" Padding="10,13">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ContentPresenter VerticalAlignment="Center"/>
            <Grid x:Name="Track" Grid.Column="1" Width="36" Height="20" Margin="12,0,0,0" VerticalAlignment="Center" SnapsToDevicePixels="False">
              <Border x:Name="TrackSurface" Background="{DynamicResource LineBrush}" CornerRadius="10" SnapsToDevicePixels="False"/>
              <Ellipse x:Name="Knob" Width="16" Height="16" Fill="{DynamicResource CardBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2" SnapsToDevicePixels="False"/>
            </Grid>
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="TrackSurface" Property="Background" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Knob" Property="Fill" Value="White"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
      <Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="36"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Background" Value="{DynamicResource InputBrush}"/><Setter Property="Padding" Value="12,6"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="SettingInput" TargetType="TextBox">
      <Setter Property="Height" Value="36"/><Setter Property="Padding" Value="0"/><Setter Property="TextAlignment" Value="Center"/>
      <Setter Property="Background" Value="{DynamicResource CardBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
        <Border x:Name="InputSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
          <ScrollViewer x:Name="PART_ContentHost" Margin="8,0"/>
        </Border>
        <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="InputSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SpinButton" TargetType="Button">
      <Setter Property="Width" Value="18"/><Setter Property="Height" Value="17"/><Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="4"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.65"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="PresetChoice" TargetType="RadioButton">
      <Setter Property="Height" Value="42"/><Setter Property="MinWidth" Value="58"/><Setter Property="Margin" Value="0,0,7,7"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Surface" Background="{DynamicResource InputBrush}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="9" Padding="10,6"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.82"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="CornerChoice" TargetType="RadioButton">
      <Setter Property="Height" Value="34"/><Setter Property="Margin" Value="0,0,3,0"/><Setter Property="FontSize" Value="11"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Surface" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Background="Transparent" CornerRadius="8" Padding="4"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.82"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ThemeChoice" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Margin" Value="0,0,7,7"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Border x:Name="Choice" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Background="Transparent" CornerRadius="10" Padding="8,7">
          <StackPanel Orientation="Horizontal"><Ellipse Width="14" Height="14" Fill="{TemplateBinding Tag}" Margin="0,0,6,0"/><ContentPresenter VerticalAlignment="Center"/></StackPanel>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Choice" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Choice" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Choice" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Height" Value="36"/><Setter Property="MinWidth" Value="78"/>
      <Setter Property="Padding" Value="16,6"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="White"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.88"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.72"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="TaskMenu" TargetType="ContextMenu">
      <Setter Property="HasDropShadow" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
        <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="5"><ItemsPresenter/></Border>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="TaskMenuItem" TargetType="MenuItem">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
        <Border x:Name="Surface" Background="Transparent" CornerRadius="6" Padding="14,9"><ContentPresenter ContentSource="Header"/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid>
  <Border x:Name="Card" Background="{DynamicResource CardBrush}" CornerRadius="18" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Margin="1" SnapsToDevicePixels="False">
    <Grid x:Name="CardContent">
    <Grid x:Name="MainPanel" Margin="22,20,22,16">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid x:Name="DragHeader" Background="Transparent" Margin="0,0,0,20" Cursor="SizeAll">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Image x:Name="HeaderIcon" Width="30" Height="30" Margin="0,0,10,0" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
            <Grid Width="126" Height="34" VerticalAlignment="Center">
              <TextBlock x:Name="TitleLabel" Text="DeskTodo" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="可在设置中修改名称"/>
              <Border x:Name="TitleEditSurface" Visibility="Collapsed" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="7" Padding="7,1">
                <TextBox x:Name="TitleEditor" MaxLength="12" FontSize="20" FontWeight="SemiBold" Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0" Padding="0" VerticalContentAlignment="Center" FocusVisualStyle="{x:Null}" AutomationProperties.Name="主页标题"/>
              </Border>
            </Grid>
          </StackPanel>
          <TextBlock x:Name="DateLabel" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,10,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,-2,-5,0">
          <Button x:Name="LockButton" Style="{StaticResource LockIconButton}" ToolTip="锁定位置" AutomationProperties.Name="锁定位置"><Grid x:Name="LockGlyph" Width="16" Height="16" IsHitTestVisible="False" UseLayoutRounding="False" SnapsToDevicePixels="False"><Path Data="M 3,7 L 13,7 L 13,14 L 3,14 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeLineJoin="Round"/><Path x:Name="LockShackle" Data="M 5,7 L 5,4.5 C 5,0.5 11,0.5 11,4.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Grid></Button>
          <Button x:Name="MinimizeButton" Style="{StaticResource IconButton}" Width="24" Visibility="Collapsed" ToolTip="最小化到托盘" AutomationProperties.Name="最小化到托盘" IsTabStop="False" Focusable="False">
            <Grid x:Name="MinimizeGlyph" Width="16" Height="16" IsHitTestVisible="False" UseLayoutRounding="False" SnapsToDevicePixels="False"><Path Data="M 2,8 L 14,8" Width="16" Height="16" Stretch="None" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
          </Button>
          <Button x:Name="CloseButton" Style="{StaticResource IconButton}" Width="24" Visibility="Collapsed" ToolTip="关闭 DeskTodo" AutomationProperties.Name="关闭 DeskTodo" IsTabStop="False" Focusable="False">
            <Grid x:Name="CloseGlyph" Width="16" Height="16" IsHitTestVisible="False"><Path Data="M 3,3 L 13,13 M 13,3 L 3,13" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Grid>
          </Button>
          <Button x:Name="MenuButton" Style="{StaticResource IconButton}" ToolTip="设置" AutomationProperties.Name="设置">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
              <Ellipse Width="2.5" Height="2.5" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="1.5,0"/>
              <Ellipse Width="2.5" Height="2.5" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="1.5,0"/>
              <Ellipse Width="2.5" Height="2.5" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="1.5,0"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
      <Border x:Name="AddBar" Grid.Row="1" Background="{DynamicResource InputBrush}" CornerRadius="10" Padding="12,5,5,5" Margin="0,0,0,22">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Grid>
            <TextBox x:Name="AddInput" Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0" Padding="0,5" VerticalContentAlignment="Center" MaxLength="500" FontSize="13" FocusVisualStyle="{x:Null}" AutomationProperties.Name="添加待办"/>
            <TextBlock x:Name="InputHint" Text="添加一件要做的事…" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False" VerticalAlignment="Center">
              <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=AddInput}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=AddInput}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
          </Grid>
          <Button Grid.Column="1" x:Name="AddButton" Style="{StaticResource AddButtonStyle}" ToolTip="添加（Enter）" AutomationProperties.Name="添加">
            <Grid Width="18" Height="18" IsHitTestVisible="False">
              <Border Width="14" Height="1.8" CornerRadius="0.9" Background="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <Border Width="1.8" Height="14" CornerRadius="0.9" Background="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
          </Button>
        </Grid>
      </Border>
      <Grid Grid.Row="2">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,10"><TextBlock Text="未完成" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="PendingCount" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource MutedBrush}"/></Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
          <StackPanel>
            <StackPanel x:Name="PendingList"/>
            <StackPanel x:Name="EmptyPanel" Margin="0,32,0,30" HorizontalAlignment="Center">
              <Border Width="46" Height="46" CornerRadius="23" Background="{DynamicResource InputBrush}" HorizontalAlignment="Center"><Path Data="M 13,23 L 20,30 L 33,16" Stroke="#A6B6A6" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Border>
              <TextBlock x:Name="EmptyTitle" Text="把想做的事，先记下来" HorizontalAlignment="Center" Margin="0,15,0,6" FontSize="13"/>
              <TextBlock x:Name="EmptySubtitle" Text="一件一件来，不必着急" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" FontSize="11"/>
            </StackPanel>
            <Grid Margin="0,10,0,0">
              <Expander x:Name="CompletedSection" Style="{StaticResource CompletedExpander}" IsExpanded="False" AutomationProperties.Name="已完成">
                <Expander.Header><TextBlock x:Name="CompletedHeader" Text="已完成（0）" Foreground="{DynamicResource MutedBrush}" FontSize="12"/></Expander.Header>
                <StackPanel x:Name="CompletedList"/>
              </Expander>
              <Button x:Name="ClearCompletedButton" HorizontalAlignment="Right" VerticalAlignment="Top" Width="28" Height="32" Margin="0,10,0,0" Style="{StaticResource IconButton}" ToolTip="清空已完成" AutomationProperties.Name="清空已完成">
