      <Grid Grid.Row="1">
        <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="11" Padding="12">
          <TextBox x:Name="EditInput" TextWrapping="Wrap" AcceptsReturn="True" MaxLength="500" Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0" FontSize="14" VerticalScrollBarVisibility="Auto" FocusVisualStyle="{x:Null}" AutomationProperties.Name="事项内容"/>
