        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="点击其他位置保存 · Esc 取消 · Ctrl+Enter 保存" FontSize="10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
          <Button x:Name="EditCancelButton" Content="取消" Style="{StaticResource ActionButton}" Width="72" Margin="0,0,10,0"/>
          <Button x:Name="EditSaveButton" Content="保存" Style="{StaticResource PrimaryButton}"/>
        </StackPanel>
      </Grid>
    </Grid>
    <Grid x:Name="ReminderPanel" Visibility="Collapsed" Margin="22,20,22,16" Background="{DynamicResource CardBrush}">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Margin="0,0,0,16">
        <TextBlock Text="事项提醒" FontSize="23" FontWeight="SemiBold"/>
        <TextBlock Text="只提醒这一条未完成事项" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"/>
      </StackPanel>
