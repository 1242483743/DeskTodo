        <StackPanel>
          <Border Background="{DynamicResource InputBrush}" CornerRadius="10" Padding="12,10" Margin="0,0,0,12"><TextBlock x:Name="ReminderItemText" TextWrapping="Wrap" MaxHeight="50" TextTrimming="CharacterEllipsis"/></Border>
          <CheckBox x:Name="ItemIntervalToggle" Style="{StaticResource SettingToggle}" AutomationProperties.Name="为此事项开启间隔提醒">
            <StackPanel><TextBlock Text="间隔提醒"/><TextBlock Text="按小时和分钟重复提醒" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/></StackPanel>
          </CheckBox>
          <Border x:Name="ItemIntervalPanel" Background="{DynamicResource InputBrush}" CornerRadius="10" Padding="10,8" Margin="10,0,10,9">
            <StackPanel><TextBlock Text="每隔" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,7"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ItemReminderHours" Style="{StaticResource SettingInput}" MaxLength="3" AutomationProperties.Name="间隔小时"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><Button x:Name="HoursUpButton" Style="{StaticResource SpinButton}" AutomationProperties.Name="小时加一"><Path Data="M 4,7 L 9,3 L 14,7" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8"/></Button><Button x:Name="HoursDownButton" Style="{StaticResource SpinButton}" AutomationProperties.Name="小时减一"><Path Data="M 4,3 L 9,7 L 14,3" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8"/></Button></StackPanel><TextBlock Grid.Column="2" Text="小时" Margin="6,0,0,0" VerticalAlignment="Center"/></Grid>
                <Grid Grid.Column="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ItemReminderMinutes" Style="{StaticResource SettingInput}" MaxLength="2" AutomationProperties.Name="间隔分钟"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><Button x:Name="MinutesUpButton" Style="{StaticResource SpinButton}" AutomationProperties.Name="分钟加一"><Path Data="M 4,7 L 9,3 L 14,7" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8"/></Button><Button x:Name="MinutesDownButton" Style="{StaticResource SpinButton}" AutomationProperties.Name="分钟减一"><Path Data="M 4,3 L 9,7 L 14,3" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8"/></Button></StackPanel><TextBlock Grid.Column="2" Text="分钟" Margin="6,0,0,0" VerticalAlignment="Center"/></Grid>
              </Grid>
            </StackPanel>
          </Border>
          <CheckBox x:Name="ItemDailyToggle" Style="{StaticResource SettingToggle}" AutomationProperties.Name="为此事项开启每天提醒">
            <StackPanel><TextBlock Text="每天提醒"/><TextBlock Text="每天在同一时间提醒一次" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/></StackPanel>
          </CheckBox>
          <Border x:Name="ItemDailyPanel" Background="{DynamicResource InputBrush}" CornerRadius="10" Padding="10,8" Margin="10,0,10,8">
            <StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="每天" VerticalAlignment="Center"/><TextBox Grid.Column="1" x:Name="ItemReminderDailyTime" Style="{StaticResource SettingInput}" Margin="8,0,0,0" MaxLength="5" AutomationProperties.Name="每天提醒时间"/><StackPanel Grid.Column="2" VerticalAlignment="Center"><Button x:Name="DailyTimeUpButton" Style="{StaticResource SpinButton}" AutomationProperties.Name="每天时间增加一分钟"><Path Data="M 4,7 L 9,3 L 14,7" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8"/></Button><Button x:Name="DailyTimeDownButton" Style="{StaticResource SpinButton}" AutomationProperties.Name="每天时间减少一分钟"><Path Data="M 4,3 L 9,7 L 14,3" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8"/></Button></StackPanel><TextBlock Grid.Column="3" Text="提醒" Margin="6,0,0,0" VerticalAlignment="Center"/></Grid><TextBlock Text="24 小时制，例如 20:30" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,0"/></StackPanel>
          </Border>
          <TextBlock x:Name="ReminderEditorMessage" Text="两种提醒可以同时开启" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="10,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </ScrollViewer>
      <Grid Grid.Row="2" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Button x:Name="ReminderClearButton" Content="清除提醒" Style="{StaticResource ActionButton}" Width="76" Background="Transparent" Foreground="{DynamicResource MutedBrush}" Margin="0" HorizontalAlignment="Left"/>
