                      <Ellipse x:Name="PositionMarkerTopRight" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="14" Fill="White" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.8" SnapsToDevicePixels="False"/>
                      <Ellipse x:Name="PositionMarkerBottomLeft" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="14" Fill="White" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.8" SnapsToDevicePixels="False"/>
