                          <Path Data="M 0,73 C 32,58 60,74 91,61 C 116,50 144,72 182,56 L 182,102 L 0,102 Z" Fill="#8CB3AE" Opacity="0.88" Stretch="Fill" VerticalAlignment="Bottom" Height="52"/>
