<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DeskTodo 安装" Width="560" Height="440" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" FontFamily="Microsoft YaHei UI" FontSize="14" Background="#F8FBFD" UseLayoutRounding="True">
  <Window.Resources>
    <Style TargetType="Button"><Setter Property="Foreground" Value="#233F4C"/><Setter Property="Background" Value="#EAF2F5"/><Setter Property="Padding" Value="20,12"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.85"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#233F4C"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#233F4C"/><Setter Property="Margin" Value="0,12"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border x:Name="Box" Width="20" Height="20" CornerRadius="5" BorderThickness="1.8" BorderBrush="#9FB8C3" VerticalAlignment="Center"><Path x:Name="Tick" Data="M 3,9 L 7,13 L 14,5" Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/></Border><ContentPresenter Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#3D758C"/><Setter TargetName="Box" Property="BorderBrush" Value="#3D758C"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  </Window.Resources>
  <Grid Margin="32,30,32,26">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image x:Name="SetupIcon" Width="48" Height="48" Margin="0,0,16,0" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/><StackPanel Grid.Column="1"><TextBlock x:Name="Heading" Text="安装 DeskTodo" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="Subtitle" FontSize="12" Foreground="#7D929C" Margin="0,6,0,0"/></StackPanel></Grid>
    <StackPanel Grid.Row="1" Margin="0,28,0,12">
      <TextBlock x:Name="Description" Text="" LineHeight="24"/>
      <StackPanel x:Name="LocationPage">
        <TextBlock x:Name="PathLabel" Text="安装位置" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Border Background="#EAF2F5" CornerRadius="10" Padding="12,11" BorderBrush="#DCE7EB" BorderThickness="1"><TextBox x:Name="InstallPath" FontSize="13" BorderThickness="0" Background="Transparent" Foreground="#233F4C" VerticalContentAlignment="Center" HorizontalScrollBarVisibility="Hidden"/></Border>
          <Button x:Name="Browse" Grid.Column="1" Content="浏览…" Margin="10,0,0,0"/>
        </Grid>
      </StackPanel>
      <StackPanel x:Name="ShortcutPage" Visibility="Collapsed">
        <TextBlock Text="选择快捷方式" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <CheckBox x:Name="StartMenuShortcut" Content="添加到开始菜单" IsChecked="True"/>
        <CheckBox x:Name="DesktopShortcut" Content="添加桌面快捷方式"/>
      </StackPanel>
      <StackPanel x:Name="FinishOptions" Visibility="Collapsed"><CheckBox x:Name="LaunchApp" Content="启动 DeskTodo" IsChecked="True"/></StackPanel>
      <TextBlock x:Name="DataNote" Text="" Visibility="Collapsed" Foreground="#7D929C" FontSize="12" Margin="0,18,0,0"/>
    </StackPanel>
    <StackPanel Grid.Row="2"><ProgressBar x:Name="Progress" Height="4" IsIndeterminate="True" Visibility="Collapsed" Foreground="#3D758C"/><TextBlock x:Name="Status" Foreground="#7D929C" FontSize="12" Margin="0,8,0,8"/></StackPanel>
    <Grid Grid.Row="3" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="Back" Content="上一步" HorizontalAlignment="Left" Visibility="Collapsed"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="Cancel" Content="取消" Margin="0,0,10,0"/><Button x:Name="Primary" Content="下一步" Background="#3D758C" Foreground="White" MinWidth="104"/></StackPanel></Grid>
  </Grid>
</Window>
